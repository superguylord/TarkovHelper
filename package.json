{
  "name": "tarkov-helper",
  "productName": "TarkovHelper",
  "version": "0.1.2",
  "private": true,
  "description": "Личный помощник для Escape from Tarkov: карта, квесты, цены",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "pack": "electron-vite build && electron-builder --dir",
    "installer": "electron-vite build && electron-builder --win nsis --publish never",
    "release": "powershell -ExecutionPolicy Bypass -File scripts/release.ps1"
  },
  "build": {
    "appId": "local.tarkovhelper",
    "productName": "TarkovHelper",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "asar": false,
    "extraResources": [
      {
        "from": "resources/ocr",
        "to": "ocr"
      }
    ],
    "win": {
      "target": "dir",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "TarkovHelper",
      "artifactName": "TarkovHelper-Setup-${version}.${ext}",
      "installerLanguages": [
        "ru_RU"
      ],
      "language": "1049",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "superguylord",
        "repo": "TarkovHelper",
        "releaseType": "release"
      }
    ]
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "electron-updater": "^6.8.11",
    "leaflet": "^1.9.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.6"
  },
  "author": "nosleep",
  "repository": {
    "type": "git",
    "url": "https://github.com/superguylord/TarkovHelper.git"
  }
}
